# Kopieer naar .env en vul alleen daar je eigen gegevens in.
TOKEN=
CLIENT_ID=
# Optioneel voor handmatige commandregistratie / oude instellingenmigratie.
GUILD_ID=
# Gebruikers-ID's, GEEN rol-ID's. Meerdere waarden scheiden met komma's.
OWNER_IDS=
DEVELOPER_IDS=
# VIP-rol-ID's uit je servers; verjaardag volgt Birthday.Role per server.
VIP_ROLE_IDS=
MESSAGE_CONTENT_INTENT=true

# Optionele AI-chat. In Discord afzonderlijk aanzetten via AIChat.Enabled.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# Alleen voor een eigen externe HTTPS-bridge (minimaal 32 tekens).
OLLAMA_BRIDGE_TOKEN=

# Optionele lokale overschrijving van config/updates.js.
# De openbare repositorylink hoort normaal in config/updates.js.
GITHUB_REPOSITORY=
UPDATE_CHECK_ENABLED=true
