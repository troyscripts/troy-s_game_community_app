# Kopieer naar .env en vul alleen daar je eigen gegevens in.
TOKEN=
CLIENT_ID=
# Optioneel voor handmatige commandregistratie / oude instellingenmigratie.
GUILD_ID=
# Gebruikers-ID's, GEEN rol-ID's. Meerdere waarden scheiden met komma's.
OWNER_IDS=
DEVELOPER_IDS=
# VIP-rol-ID's uit je servers; verjaardag volgt Birthday.Role per server.
VIP_ROLE_IDS=
MESSAGE_CONTENT_INTENT=true

# Dezelfde sleutel wordt gebruikt voor poll-, welkomst- en /say-vertalingen.
# AIChat.Enabled hoeft voor deze vertaalfuncties niet aan te staan.
GROQ_API_KEY=VUL_HIER_JE_GROQ_SLEUTEL_IN
GROQ_MODEL=openai/gpt-oss-20b

# Optionele lokale overschrijving van config/updates.js.
# De openbare repositorylink hoort normaal in config/updates.js.
GITHUB_REPOSITORY=
UPDATE_CHECK_ENABLED=true

# ======================================================================
# BOTBERICHT-KOPPELING — drie botinstallaties, één centraal meldpunt
# ======================================================================
# Eerst op ALLE drie installeren/configureren. Daarna true zetten.
# false = /botbericht verstuurt alleen via deze bot, zoals voorheen.
# true = gekoppeld; publiceren kan uitsluitend via de centrale bot hieronder.
BROADCAST_ENABLED=false

# De centrale bot is vast: 1486317240319082597 (niet via .env te wijzigen).
# De centrale rol volgt het werkelijke ingelogde bot-ID, NIET de servernaam.
# Alle drie gebruiken dezelfde lijst: centraal ID + de twee andere BOT-ID's.
# Voeg de twee echte ID's toe, gescheiden door komma's. GEEN gebruikers-ID's.
BROADCAST_BOT_IDS=1486317240319082597

# Genereer EEN KEER een willekeurige sleutel met dit commando:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Plak dezelfde 64 hextekens in alle drie de .env-bestanden.
# Dit is GEEN Discord-token. Bewaar de sleutel privé; nooit op GitHub zetten.
# Verkeer wordt versleuteld en geauthenticeerd met AES-256-GCM.
BROADCAST_SECRET=

# ALLEEN CENTRALE BOT: luisteradres en extra toegewezen Pterodactyl-poort.
# Vervang 8080 door de extra allocation-poort uit je hostingpaneel.
# Gebruik niet een poort die al door een andere dienst wordt gebruikt.
# 0.0.0.0 luistert op alle interfaces binnen de container.
# De twee ontvangende bots negeren BIND en PORT; daar is geen extra poort nodig.
BROADCAST_BIND=0.0.0.0
BROADCAST_PORT=8080

# ALLEEN DE TWEE ONTVANGERS: bereikbaar adres van de centrale allocation.
# Voorbeeld: http://JOUW-HOSTING-IP:TOEGEWEZEN-POORT
# Ook https://jouw-domein.example kan, met een eigen werkende reverse proxy.
# Niet het Pterodactyl-paneeladres; niet localhost bij aparte containers.
# Laat op de centrale bot leeg. Geen pad, token of wachtwoord in de URL.
BROADCAST_URL=

# Alle drie: ophalen per aantal seconden (5 t/m 300; standaard 15).
# Offline ontvangers halen wachtende berichten op zodra de verbinding terug is.
# Houd de systeemklokken gelijk; verzoeken ouder dan 60 seconden worden geweigerd.
BROADCAST_POLL_SECONDS=15
