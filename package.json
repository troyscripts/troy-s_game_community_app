{
  "name": "troys-gamecommunity-bot",
  "version": "3.1.7",
  "description": "Professionele Discord Bot voor Troy's Gamecommunity",
  "main": "index.js",
  "scripts": {
    "start": "node .",
    "dev": "nodemon .",
    "deploy": "node deploy-commands.js",
    "check": "node scripts/validate.js",
    "prepare:github": "node scripts/prepare-github.cjs",
    "test:updates": "node --test scripts/test-update-checker.cjs",
    "notify:tiktok": "node scripts/link-tiktok.cjs",
    "test:languages": "node scripts/test-languages.js",
    "test:living": "node scripts/test-living.cjs",
    "test:business": "node scripts/test-business.cjs",
    "test:loans": "node scripts/test-loans.cjs",
    "test:softmod": "node scripts/test-softmod.cjs",
    "test:honeypot": "node scripts/test-honeypot.cjs",
    "test:tickets": "node scripts/test-ticket-access.cjs && node scripts/test-ticket-upgrade.cjs",
    "test:security": "node scripts/test-security.cjs",
    "test": "node scripts/run-tests.cjs",
    "check:versions": "node scripts/check-versions.cjs",
    "ci": "npm run check && npm run check:versions && npm test",
    "test:radio": "node scripts/test-radio.cjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "better-sqlite3": "^12.4.1",
    "chalk": "^4.1.2",
    "dayjs": "^1.11.13",
    "discord-html-transcripts": "3.2.0",
    "discord.js": "^14.21.0",
    "dotenv": "^17.2.2",
    "ffmpeg-static": "5.3.0",
    "fs-extra": "^11.3.2",
    "glob": "^11.0.3",
    "opusscript": "0.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  },
  "overrides": {
    "undici": "6.29.1"
  }
}
